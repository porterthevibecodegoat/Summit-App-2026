# Public content is readable without a password. Private connection requests are
# validated on the server and delivered only when this secure webhook is configured.
MESSAGE_DELIVERY_WEBHOOK_URL=
MESSAGE_DELIVERY_WEBHOOK_SECRET=

# Use your deployment provider's access controls for preview/staging passwords.
# Production attendee authentication should use Supabase Auth with RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only ticket reservation endpoint. It must atomically enforce the
# 1,000-ticket cap before issuing a ticket or starting an optional donation.
TICKET_RESERVATION_WEBHOOK_URL=
TICKET_RESERVATION_WEBHOOK_SECRET=
